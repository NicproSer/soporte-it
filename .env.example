# Base de datos MongoDB (local o Atlas)
DATABASE_URL="mongodb://localhost:27017/soporte-it"

# URL pública usada dentro de los códigos QR
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Secreto para firmar la cookie de sesión del administrador (cámbialo en producción)
JWT_SECRET="cambia-este-secreto-en-produccion"

# Opcional: credenciales que usará npm run seed:admin
ADMIN_EMAIL="admin@empresa.com"
ADMIN_PASSWORD="Admin123!"
ADMIN_NAME="Administrador"

# ── Correo SMTP de Gmail (notificaciones de visitas técnicas) ──────────────
# Crea una "contraseña de aplicación" en https://myaccount.google.com/apppasswords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="remite.tucorreo@gmail.com"
SMTP_PASS="xxxx xxxx xxxx xxxx"
# Destinatarios de las solicitudes: 2 correos separados por coma
MAIL_TO_ADMIN="admin1@empresa.com,admin2@empresa.com"
