# Base de datos MongoDB (local o Atlas)
DATABASE_URL="mongodb://localhost:27017/soporte-it"

# URL pública usada dentro de los códigos QR
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Secreto para firmar la cookie de sesión del administrador (cámbialo en producción)
JWT_SECRET="cambia-este-secreto-en-produccion"

# Opcional: credenciales que usará npm run seed:admin
ADMIN_EMAIL="admin@empresa.com"
ADMIN_PASSWORD="Admin123!"
ADMIN_NAME="Administrador"
