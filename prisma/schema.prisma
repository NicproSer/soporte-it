generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  TECHNICIAN
}

enum LabelStatus {
  AVAILABLE
  ASSIGNED
  RETIRED
}

enum EquipmentStatus {
  ACTIVE
  MAINTENANCE
  INACTIVE
  REPLACED
}

enum VisitStatus {
  PENDING
  PROPOSED
  REJECTED
  CONFIRMED
  RESCHEDULE_REQUESTED
  COMPLETED
  CANCELLED
}

model User {
  id            String          @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  email         String          @unique
  passwordHash  String
  role          UserRole        @default(TECHNICIAN)
  // true si la contraseña sigue siendo la temporal generada al crear la
  // cuenta desde el panel (el usuario debe cambiarla al primer ingreso).
  mustChangePassword Boolean    @default(false)
  // NOTE: intentionally NOT @unique. MongoDB treats every missing/null field
  // as the same value for unique indexes, so creating a second user without a
  // reset token fails with P2002 on `User_resetTokenHash_key`. Uniqueness by
  // token is guaranteed by the SHA-256 hash itself (crypto-random); lookups
  // use findFirst and tokens are single-use (cleared after use).
  resetTokenHash   String?
  resetTokenExpiresAt DateTime?
  interventions Intervention[]
  acceptedVisits    VisitRequest[] @relation("AcceptedVisits")
  closedVisits      VisitRequest[] @relation("ClosedVisits")
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model Label {
  id        String      @id @default(auto()) @map("_id") @db.ObjectId
  uid       String      @unique
  code      String      @unique
  status    LabelStatus @default(AVAILABLE)
  equipment Equipment?
  batchId   String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model Equipment {
  id             String          @id @default(auto()) @map("_id") @db.ObjectId
  labelId        String          @unique @db.ObjectId
  label          Label           @relation(fields: [labelId], references: [id])
  name           String
  category       String
  brand          String?
  model          String?
  serialNumber   String?
  location       String?
  installationAt DateTime?
  warrantyUntil  DateTime?
  status         EquipmentStatus @default(ACTIVE)
  notes          String?
  // Propietario/cliente del equipo (se registra al crear la ficha técnica;
  // permite prellenar y agrupar solicitudes de visita por cliente)
  ownerName      String?
  ownerEmail     String?
  ownerPhone     String?
  interventions  Intervention[]
  visits         VisitRequest[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Intervention {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  equipmentId String    @db.ObjectId
  equipment   Equipment @relation(fields: [equipmentId], references: [id])
  technicianId String   @db.ObjectId
  technician  User      @relation(fields: [technicianId], references: [id])
  visitRequestId String? @db.ObjectId
  visitRequest   VisitRequest? @relation(fields: [visitRequestId], references: [id])
  type        String
  description String
  performedAt DateTime  @default(now())
  createdAt   DateTime  @default(now())
}

model VisitRequest {
  id                  String      @id @default(auto()) @map("_id") @db.ObjectId
  customerName        String
  customerEmail       String
  // Nombre/correo de la persona de contacto que solicita la visita (puede
  // diferir del propietario registrado en el equipo)
  contactName         String?
  contactEmail        String?
  customerPhone       String?
  address             String
  issueDescription    String
  preferredDate       DateTime?
  proposedDate        DateTime?
  proposedMessage     String?
  status              VisitStatus @default(PENDING)
  responseTokenHash   String?
  tokenExpiresAt      DateTime?
  // Tokens para el flujo de respuesta del cliente (aceptar / rechazar / proponer otra fecha)
  acceptToken         String?     @unique
  rejectToken         String?     @unique
  proposeToken        String?     @unique
  customerSuggestedDate DateTime?
  customerNote        String?
  // true si el correo de propuesta al cliente falló (se puede reintentar desde el dashboard)
  proposalEmailFailed Boolean       @default(false)
  // Flujo tipo tickets: quién aceptó la solicitud y quién cerró la visita
  acceptedById        String?       @db.ObjectId
  acceptedBy          User?         @relation("AcceptedVisits", fields: [acceptedById], references: [id])
  acceptedAt          DateTime?
  closedById          String?       @db.ObjectId
  closedBy            User?         @relation("ClosedVisits", fields: [closedById], references: [id])
  closedAt            DateTime?
  completionNotes     String?
  equipmentId         String?     @db.ObjectId
  equipment           Equipment?  @relation(fields: [equipmentId], references: [id])
  interventions       Intervention[]
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
}
